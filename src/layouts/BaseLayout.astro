---
interface Props {
  title?: string;
}

const { title = "Decoheron - Solutions-Focused Cyber Security" } = Astro.props;
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
        <meta name="description" content="Liability-focused, deterministic cyber security provider in Melbourne.">
        <meta name="author" content="info@decoheron.com">
        <title>{title}</title>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
        <link rel="icon" type="image/png" href="/favicon-96x96.png?v=20260821" sizes="96x96" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=20260821" />
        <link rel="shortcut icon" href="/favicon.ico?v=20260821" />
        <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=20260821" />
        <meta name="apple-mobile-web-app-title" content="Decoheron" />
        <link rel="manifest" href="/site.webmanifest?v=20260821" />
</head>
<body class="d-flex flex-column min-vh-100 bg-dark">

    <Navbar />

    <main class="paper-grain-overlay">
        <slot />
    </main>

    <Footer />

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
</body>
</html>

<style is:global>
:root {
    /* Backgrounds & Text */
    /* --bs-body-bg: #FBF3D5; */         /* Elegant Cream */
    /* --bs-body-color: #1E2530; */      /* High-contrast Charcoal */
    --bs-body-bg: #FFFFFF;         
    --bs-body-color: #0B2340;       


    /* Primary: Deep Sapphire / Indigo */
    --bs-primary: #0A1B6B;
    --bs-primary-rgb: 10, 27, 107;

    /* Secondary: Electric Cobalt Blue */
   /* --bs-secondary: #103ECE;
    --bs-secondary-rgb: 16, 62, 206;*/
    
    --bs-secondary: #0310A4;
    --bs-secondary-rgb: 3, 16, 164;

    /* Surfaces & Dark Accent */
/*    --bs-light: #F5E8C3;   */         /* Soft Cream Surface */
 /*   --bs-dark: #050D2E;      */      /* Midnight Blue-Black */
    /* Surfaces & Dark Accent */
    --bs-light: #FFFFFF;            /* Soft Cream Surface */
    --bs-dark: #050D2E;
    --bs-dark-rgb: 5, 13, 46;

    --bs-body-font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
    --bs-heading-font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
}

/* Set root and body base background & font family */
html, body {
    color: var(--bs-body-color);
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif !important;
}
main {
    background-color: var(--bs-body-bg);
}
header {
    border-bottom: 2px solid var(--bs-secondary) !important;
}
/* Custom Utilities */
.hero-logo {
    max-height: 42px;
    width: auto;
}

.square-bullet {
    color: var(--bs-secondary);
    font-size: 1rem;
    line-height: 1.5;
}

.btn-primary {
    background-color: var(--bs-primary);
    border-color: var(--bs-primary);
}

.btn-primary:hover {
    background-color: var(--bs-secondary);
    border-color: var(--bs-secondary);
}

.btn-outline-navy {
    color: var(--bs-secondary);
    border-color: var(--bs-secondary);
}

.btn-outline-navy:hover {
    background-color: var(--bs-secondary);
    color: #FFFFFF;
}

.text-subtle-light {
    color: #A0AEC0;
}
.paper-grain-overlay {
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='paperNoise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23paperNoise)' opacity='0.2'/%3E%3C/svg%3E");
    background-repeat: repeat;
    background-size: 200px 200px;
}
</style>
