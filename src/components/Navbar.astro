---
import { Image } from 'astro:assets';
import logoImage from '../assets/d_logo.png';

const pathname = Astro.url.pathname;
---
<nav class="navbar navbar-expand-lg navbar-cream sticky-top py-3">
    <div class="container">
        <a class="navbar-brand d-flex align-items-center gap-2 fw-bold fs-4" href="/">
            <Image src={logoImage} alt="Decoheron Logo" class="img-fluid dh-logo" loading="eager" />
            <span>Decoheron</span>
        </a>
        <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav ms-auto align-items-lg-center">
                <li class="nav-item">
                    <a class:list={['nav-link', { active: pathname === '/' }]} aria-current={pathname === '/' ? 'page' : undefined} href="/">Home</a>
                </li>
 
               <!-- <li class="nav-item">
                    <a class:list={['nav-link', { active: pathname.startsWith('/liabilities') }]} aria-current={pathname.startsWith('/liabilities') ? 'page' : undefined} href="/industries">Industries</a>
                </li> -->
                <li class="nav-item">
                    <a class:list={['nav-link', { active: pathname.startsWith('/solution') }]} aria-current={pathname.startsWith('/solution') ? 'page' : undefined} href="/solution">Our Approach</a>
                </li>
                <li class="nav-item">
                    <a class:list={['nav-link', { active: pathname.startsWith('/case-studies') }]} aria-current={pathname.startsWith('/case-studies') ? 'page' : undefined} href="/case-studies">Case Studies</a>
                </li>
                 <li class="nav-item">
                    <a class:list={['nav-link', { active: pathname.startsWith('/liabilities') }]} aria-current={pathname.startsWith('/liabilities') ? 'page' : undefined} href="/liabilities">Why It Matters</a>
                </li>
                <li class="nav-item">
                    <a class:list={['nav-link', { active: pathname.startsWith('/about') }]} aria-current={pathname.startsWith('/about') ? 'page' : undefined} href="/about">About</a>
                </li>
 <!--                -->
                <li class="nav-item navbar-cta">
                    <a class="dh-btn dh-btn--nav" href="#briefing">Book a Call</a>
                </li>
           </ul>
        </div>
    </div>
</nav>

