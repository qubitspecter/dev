---
interface Props {
    title?: string;
    text?: string;
    button?: string;
}

const {
    title = "Transition to Legally Defensible Security",
    text = "We replace subjective assessments with verifiable, deterministic controls that satisfy regulatory scrutiny and safeguard your board against fiduciary liability.",
    button = "Book a Discussion",
} = Astro.props;
---
<!-- Resolution / Call to Action -->
<section class="cta">
    <div class="cta__inner">
        <h2 class="cta__title">{title}</h2>
        <p class="cta__text">
            {text}
        </p>
        <a href="#briefing" class="cta__button">{button}</a>
    </div>
</section>

<style>
    .cta {
        background: var(--dh-navy);
        color: #fff;
        padding: clamp(3rem, 6vw, 5rem) 1.5rem;
        text-align: center;
        font-family: var(--dh-sans);
        -webkit-font-smoothing: antialiased;
    }
    .cta__inner { max-width: 44rem; margin: 0 auto; }
    .cta__title {
        margin: 0;
        font-family: var(--dh-serif);
        font-weight: 400;
        font-size: clamp(1.75rem, 3.4vw, 2.5rem);
        line-height: 1.1;
        letter-spacing: -0.01em;
        color: #fff;
        text-wrap: balance;
    }
    .cta__text { margin: 1.25rem 0 0; font-size: 1.125rem; line-height: 1.55; color: rgba(255, 255, 255, 0.84); }
    .cta__button {
        display: inline-block;
        margin-top: 2rem;
        padding: 0.9rem 1.75rem;
        border-radius: 4px;
        background: var(--dh-gold);
        color: var(--dh-ink);
        font: 600 1rem/1.2 var(--dh-sans);
        text-decoration: none;
        transition: background-color 0.15s ease;
    }
    .cta__button:hover { background: #E4BD62; color: var(--dh-ink); }
    .cta__button:focus-visible { outline: 3px solid var(--dh-gold); outline-offset: 3px; }
</style>
