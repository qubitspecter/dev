---
import { controls, asdPrinciples, tierColours } from '../data/veristate';

interface Props {
  /** Control ID as written in the data file, e.g. "VS.DA.01" */
  id: string;
  /** Maps to the status-<name> class on the modal content. Defaults to "pass". */
  status?: string;
}

const { id, status = 'pass' } = Astro.props;

const c = controls.find((x) => x.id === id);
if (!c) throw new Error(`ControlModal: unknown control "${id}"`);

// "VS.DA.01" -> "modal-VS-DA-01"
const modalId = `modal-${c.id.replace(/\./g, '-')}`;
const titleId = `${modalId}-title`;
const plural = (n: number) => `${n} action${n === 1 ? '' : 's'}`;
---

<div class="modal fade control-modal" id={modalId} tabindex="-1" aria-labelledby={titleId} aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-lg">
    <div class={`modal-content status-${status}`}>
      <div class="modal-header">
        <div>
          <h2 class="modal-title fs-5 fw-bold mb-0" id={titleId}>{c.title}</h2>
          <div class="small text-body-secondary">{c.id}</div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <div class="modal-body">
        {c.description.map((p, i) => (
          <p class={i < c.description.length - 1 ? 'mb-3' : 'mb-0'}>{p}</p>
        ))}

        <hr class="my-4" />

        <div class="vs-map">
          <h3 class="vs-map-h">ASD Essentials principles</h3>
          <ul class="vs-map-list">
            {c.asd.map((a) => (
              <li>
                <span class="badge text-bg-secondary me-2">{a.id}</span>
                {asdPrinciples[a.id]}{' '}
                <span class="text-body-secondary small">({plural(a.actions)})</span>
              </li>
            ))}
          </ul>

          <h3 class="vs-map-h">SMB1001:2026 controls</h3>
          {c.smb.length === 0 ? (
            <p class="text-body-secondary small mb-3">No direct SMB1001 control.</p>
          ) : (
            <ul class="vs-map-list">
              {c.smb.map((s) => (
                <li>
                  <span class="badge me-2" style={`background:${tierColours[s.tier]}`}>{s.tier}</span>
                  {s.name}{' '}
                  <span class="text-body-secondary small">({s.coverage})</span>
                </li>
              ))}
            </ul>
          )}

          <h3 class="vs-map-h">ATT&amp;CK techniques it helps mitigate</h3>
          <div class="d-flex flex-wrap gap-2 mb-2">
            {c.attack.map((t) => (
              <span class="badge rounded-pill text-bg-light border">{t}</span>
            ))}
          </div>
        </div>
      </div>

      <div class="modal-footer">
        <button type="button" class="btn btn-primary rounded-pill px-4" data-bs-dismiss="modal">Close</button>
      </div>
    </div>
  </div>
</div>
