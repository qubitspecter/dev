---
import { Image } from 'astro:assets';
import smb1001Badge from '../assets/smb1001-silver.png';
const currentYear = new Date().getFullYear();
const pathname = Astro.url.pathname;
---

<footer class="py-4 bg-dark text-white border-top bs-secondary">

    <div class="container text-center">
            <div class="cta__inner">
        <a href="#briefing" class="cta__button">Book a Call</a>
    </div>
        <small class="text-subtle-light">&copy; {currentYear} Decoheron. All rights reserved.
            <a class:list={['nav-link', { active: pathname === '/' }]} aria-current={pathname === '/' ? 'page' : undefined} href="/privacy">Privacy Policy</a>
            <br><!-- Built for pragmatic risk reduction. --></small>
    </div>
</footer>

<style>
    .cta__inner { max-width: 44rem; margin: 0 auto; padding-bottom: 1em;}
    .cta__button {
        display: inline-block;
        margin-top: 2rem;
        padding: 0.9rem 1.75rem;
        border-radius: 4px;
        background: var(--dh-gold);
        color: var(--dh-ink);
        font: 600 1rem/1.2 var(--dh-sans);
        text-decoration: none;
        transition: background-color 0.15s ease;
    }
    .cta__button:hover { background: #E4BD62; color: var(--dh-ink); }
    .cta__button:focus-visible { outline: 3px solid var(--dh-gold); outline-offset: 3px; }
</style>