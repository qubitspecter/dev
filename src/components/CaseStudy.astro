---
import BaseLayout from '../layouts/BaseLayout.astro';
import BriefingForm from './BriefingForm.astro';

const { study } = Astro.props;
---
<BaseLayout title={`${study.title} | Decoheron`} description={study.metaDescription}>
    <!-- Hero -->
    <section class="cs dh-hero dh-hero--compact">
        <div class="dh-wrap">
            <a href="/case-studies" class="dh-hero__back">&larr; Case studies</a>
            <p class="dh-eyebrow">{study.sector}</p>
            <h1 class="dh-hero__title">{study.title}</h1>
            <p class="dh-hero__lede">{study.summary}</p>
        </div>
    </section>

    <!-- Result figures -->
    <section class="cs dh-section dh-section--compact dh-section--paper" aria-label="Results at a glance">
        <div class="dh-wrap dh-grid dh-grid--fit">
            {study.stats.map((s) => (
                <div class="dh-point">
                    <p class="dh-figure">
                        {s.from && (<><span class="dh-figure__from">{s.from}</span> <span aria-label="to">&rarr;</span> </>)}{s.breakBefore && <br />}{s.figure}
                    </p>
                    <p class="dh-point__label">{s.label}</p>
                    {s.note && <p class="dh-point__text">{s.note}</p>}
                </div>
            ))}
        </div>
    </section>

    <!-- At a glance, background, findings -->
    <section class="cs dh-section dh-section--compact">
        <div class="dh-wrap dh-stack">
            <section aria-labelledby="dh-glance">
                <h2 class="dh-h2 dh-h2--sm" id="dh-glance">At a Glance</h2>
                <dl class="dh-glance">
                    {study.glance.map(([term, value]) => (
                        <div class="dh-glance__row">
                            <dt>{term}</dt>
                            <dd>
                                {Array.isArray(value) ? (
                                    <ul class="dh-list">
                                        {value.map((v) => <li>{v}</li>)}
                                    </ul>
                                ) : value}
                            </dd>
                        </div>
                    ))}
                </dl>
            </section>

            <section aria-labelledby="cs-background">
                <h2 class="dh-h2 dh-h2--sm" id="cs-background">1. {study.sections.background}</h2>
                {study.background.map((p) => <p class="dh-body dh-body--flow">{p}</p>)}
            </section>

            <section aria-labelledby="dh-findings">
                <h2 class="dh-h2 dh-h2--sm" id="dh-findings">2. {study.sections.findings}</h2>
                {study.findingsIntro && <p class="dh-body dh-body--flow">{study.findingsIntro}</p>}
                <ul class="dh-findings">
                    {study.findings.map((f) => (
                        <li>{typeof f === 'string' ? f : (<><strong>{f.lead}</strong> {f.text}</>)}</li>
                    ))}
                </ul>
            </section>
        </div>
    </section>

    <!-- Method -->
    <section class="cs dh-section dh-section--compact dh-section--paper" aria-labelledby="cs-method">
        <div class="dh-wrap">
            <h2 class="dh-h2 dh-h2--sm" id="cs-method">3. {study.sections.method}</h2>
            <div class="cs-table" role="table">
                <div class="dh-rows__head" role="row">
                    {study.method.columns.map((c) => <div role="columnheader">{c}</div>)}
                </div>
                {study.method.rows.map((row) => (
                    <div class="dh-rows__row" role="row">
                        {row.map((cell, i) => (
                            <div class:list={['cs-cell', { 'dh-rows__lead': i === 0 }]} role="cell">
                                <span class="dh-rows__label" aria-hidden="true">{study.method.columns[i]}</span>
                                {Array.isArray(cell) ? (
                                    <ul class="dh-list">
                                        {cell.map((d) => <li>{d}</li>)}
                                    </ul>
                                ) : cell}
                            </div>
                        ))}
                    </div>
                ))}
            </div>
        </div>
    </section>

    <!-- Outcomes -->
    <section class="cs dh-section dh-section--compact" aria-labelledby="cs-result">
        <div class="dh-wrap">
            <h2 class="dh-h2 dh-h2--sm" id="cs-result">4. {study.sections.outcomes}</h2>
            <div class="dh-grid dh-grid--fit dh-grid--spaced">
                {study.outcomes.map((o) => (
                    <div class="dh-point">
                        <h3 class="dh-h3">{o.title}</h3>
                        <p class="dh-body dh-body--flow">{o.text}</p>
                    </div>
                ))}
            </div>
            <p class="dh-disclaimer">
                Client details withheld. Results are specific to this engagement and are not a guarantee of outcome.
            </p>
        </div>
    </section>
    <BriefingForm hidden={true} />
</BaseLayout>