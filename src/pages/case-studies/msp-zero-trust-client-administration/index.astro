---
import CaseStudy from '../../../components/CaseStudy.astro';

const study = {
    metaDescription:
        'How an Australian MSP replaced standing admin rights in every client tenancy with client-approved, device-bound access, and obtained cyber insurance for the first time.',
    sector: 'Managed service provider',
    title: 'Every admin session, approved by the client',
    summary:
        "When a peer MSP was pursued by a client's insurer after an incident, this MSP looked at its own position. Its engineers held standing admin rights in every client tenancy, so one compromised account could reach them all, and it had no way to prove any session was authorised. About ten weeks later, every admin session was approved by the client and came from a known, MSP-owned device. Clients had nothing to install or change, and the MSP obtained cyber insurance for the first time.",
    glance: [
        ['Client', 'Australian managed service provider (MSP)'],
        ['Scale', 'Under 10 technical staff, under 20 client tenancies'],
        ['Starting point', "An operations-focused MSP administering clients' Microsoft 365 tenancies (each client's own Microsoft 365 environment) with permanent, standing admin rights"],
        ['Why', 'To reduce its exposure to client incidents, after a peer MSP was pursued by a client\'s insurer'],
        ['Timeline', 'About ten weeks from first call to full implementation'],
        ['Result', [
            'All access to client tenancies explicitly approved by the client',
            'Admin access only from a known, MSP-owned device',
            'Access granted for two hours at a time, not permanently',
            'Nothing new required of clients',
            'Cyber insurance obtained for the first time',
        ]],
    ],
    sections: {
        background: 'Why the MSP acted',
        findings: 'What we found',
        method: 'How it works now',
        outcomes: 'What changed',
    },
    background: [
        "The MSP was focused on keeping its clients running, not on building a security practice. That changed when it learned another MSP was being pursued by a client's insurer after an incident at that client.",
        'Its own exposure was clear. Admin access to client tenancies made it a possible route into every client, and a possible party to any claim. It engaged Decoheron to design an administration model it could stand behind with clients and insurers, without adding technical or licensing requirements for those clients.',
    ],
    findings: [
        { lead: 'Standing admin rights everywhere.', text: 'Engineers held permanent admin rights in every client tenancy, available whether or not they were needed. One compromised account or device could reach every client.' },
        { lead: 'No proof of authorisation.', text: "Clients weren't part of the access process, so the MSP couldn't show that any given session had been approved." },
        { lead: 'No device control.', text: "Admin access wasn't tied to a known device." },
        { lead: 'Shared exposure.', text: 'An incident at a single client could draw the MSP into an insurance claim.' },
    ],
    method: {
        columns: ['Step', 'Who', 'Details'],
        rows: [
            ['Request', 'MSP engineer', "Requests access to a locked-down virtual Privileged Access Workstation (PAW, a computer used only for administration) through Privileged Identity Management (PIM) for Groups in the MSP's own tenancy. PIM grants access only on request, for a limited time."],
            ['Approval', 'Client', "A nominated approver at the client, using an external account in the MSP's tenancy, approves the request."],
            ['Activation', 'PIM', 'Access to the PAW is granted for two hours.'],
            ['Device', 'MSP engineer', "Signs in to a Windows 365 PAW, owned by the MSP and joined to the client's tenancy."],
            ['Device check', 'Conditional Access', "Blocks MSP administrators from every resource in the client's tenancy unless they're on that device."],
            ['Access', 'MSP engineer', "Reaches the client's admin controls from the PAW, for the approved window only."],
        ],
    },
    stats: [
        { figure: '100%', label: 'Of admin access approved by the client', note: 'Every session, with no exceptions for convenience.' },
        { figure: '0', label: 'New requirements placed on clients', note: 'No installs, no licensing changes.' },
        { figure: 'First', label: 'Cyber insurance policy obtained', note: 'Without carrying the exposure of every client tenancy.' },
    ],
    outcomes: [
        {
            title: 'For the MSP',
            text: 'It obtained cyber insurance for the first time, without carrying the full exposure of every client tenancy. It can now show any client or insurer that every admin session was approved by the client and came from a known device. That addresses the exposure behind the project, without turning an operations business into a security program.',
        },
        {
            title: 'For clients',
            text: "Clients had nothing to install or change. Nothing happens in their tenancy that they didn't approve.",
        },
        {
            title: 'Day to day',
            text: "Engineers work from a Windows 365 PAW the MSP owns, so access depends on a known device as well as credentials. Clients keep standard office hours, so approvals fit the working day, and after-hours changes go ahead only when the client's approver is available. A small number of clients with specific needs are handled through app registrations (application identities holding only the permissions they need).",
        },
    ],
    closing: {
        title: 'Working with an MSP? This is how it should work.',
        text: "We work alongside your MSP, not against them. A fixed-fee assessment shows how your MSP's access to your environment is controlled today, and how it could be proven.",
    },
};
---
<CaseStudy study={study} />
