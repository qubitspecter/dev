---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BriefingForm from '../../components/BriefingForm.astro'; 
import CallToAction from '../../components/CallToAction.astro';

// Compliance mapping data array
const ismMappings = [
  {
    id: "govern",
    domain: "Govern",
    e8: "&nbsp;",
    smb: "Lorem ipsum dolor sit amet, consectetur. Level 3 governance controls, continuous risk tracking, and leadership reporting.",
    controls: "Deterministic compliance engine with automated executive reporting, risk quantization, and real-time posture verification."
  },
  {
    id: "identify",
    domain: "Identify",
    e8: "<ul><li>Application Control</li><li>Patch Applications</li><li>User Application Hardening</li><li>Restrict Administrative Privileges</li><li>Patch Operating Systems</li><li>Multi-Factor Authentication</li></ul>",
    smb: "Lorem ipsum dolor sit amet, consectetur. Comprehensive background vetting, continuous training, and strict access policies.",
    controls: "Continuous identity verification, background screening integration, automated offboarding, and strict RBAC enforcement."
  },
  {
    id: "protect",
    domain: "Protect",
    e8: "<ul><li>Application Control</li><li>Patch Applications</li><li>Restrict Microsoft Office Macros</li><li>User Application Hardening</li><li>Restrict Administrative Privileges</li><li>Patch Operating Systems</li><li>Multi-Factor Authentication</li><li>Regular Backups</li></ul>",
    smb: "Lorem ipsum dolor sit amet, consectetur. Multi-factor physical security, visitor logging, and environmental monitoring.",
    controls: "Zero-trust edge hardware protection, encrypted HSM modules, and continuous tamper-detection logging."
  },
  {
    id: "detect",
    domain: "Detect",
    e8: "&nbsp;",
    smb: "Lorem ipsum dolor sit amet, consectetur. Encryption in transit/rest and rigorous media handling policies.",
    controls: "End-to-end quantum-resistant encryption, active DLP controls, automated data classification, and sanitization protocols."
  },
  {
    id: "respond",
    domain: "Respond",
    e8: "&nbsp;",
    smb: "Lorem ipsum dolor sit amet, consectetur. Level 3 patch cadence, hardened baseline configurations, and exploit mitigations.",
    controls: "Automated patch deployment pipelines, immutable infrastructure builds, zero-trust endpoint control, and daily vulnerability scanning."
  },
  {
    id: "recover",
    domain: "Recover",
    e8: "<ul><li>Regular Backups</li></ul>",
    smb: "Lorem ipsum dolor sit amet, consectetur. Managed detection and response with 24/7 SIEM integration and alert analysis.",
    controls: "24/7 SOC integration, automated playbook orchestration, continuous telemetry logging, and proactive threat hunting."
  }
];
---

<BaseLayout title="Solution Mapping - Decoheron">
  <div class="container py-4">
    <!-- Page Header -->
    <div class="row mb-5">
      <div class="col-lg-9">
        <span class="badge bg-primary mb-3 px-3 py-2 text-uppercase fs-6">
          Compliance & Controls Matrix
        </span>
        <h1 class="display-4 fw-bold text-primary mb-3">
          ISM Control Alignment & Solution Architecture
        </h1>
        <p class="lead text-subtle fs-5">
          See how our deterministic controls map across standard Australian government and enterprise frameworks, translating regulatory compliance into operational protection.
        </p>
      </div>
    </div>

    <!-- Solution Matrix Section -->
    <div class="mb-5">
      <div class="d-flex align-items-center justify-content-between mb-4">
        <h2 class="h3 fw-bold text-primary mb-0">Framework Mapping</h2>
        <span class="text-muted fs-6 d-lg-none">(Tap any domain to expand)</span>
      </div>

      <!-- DESKTOP VIEW: Standard Table (Visible on lg screens and up) -->
      <div class="d-none d-lg-block shadow-sm rounded-3 overflow-hidden border border-2 border-secondary-subtle">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-dark text-uppercase fs-7">
            <tr>
              <th scope="col" style="width: 22%;">ISM Function</th>
              <th scope="col" style="width: 26%;">E8 ML1</th>
              <th scope="col" style="width: 26%;">SMB1001-L3</th>
              <th scope="col" class="bg-primary text-white" style="width: 26%;">Our Controls</th>
            </tr>
          </thead>
          <tbody>
            {ismMappings.map((row) => (
              <tr>
                <td class="fw-bold text-primary bg-light" set:html={row.domain} />
                <td class="text-body-secondary small" set:html={row.e8} />
                <td class="text-body-secondary small" set:html={row.smb} />
                <td class="bg-primary-subtle fw-medium text-dark border-start border-primary border-3 small">
                  {row.controls}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <!-- MOBILE / TABLET VIEW: Accordion Cards (Visible below lg breakpoint) -->
      <div class="accordion d-lg-none shadow-sm" id="ismAccordion">
        {ismMappings.map((row, index) => (
          <div class="accordion-item border border-secondary-subtle mb-2 rounded-2 overflow-hidden">
            <h2 class="accordion-header" id={`heading-${row.id}`}>
              <button
                class={`accordion-button fw-bold text-primary ${index !== 0 ? 'collapsed' : ''}`}
                type="button"
                data-bs-toggle="collapse"
                data-bs-target={`#collapse-${row.id}`}
                aria-expanded={index === 0 ? "true" : "false"}
                aria-controls={`#collapse-${row.id}`}
              >
                {row.domain}
              </button>
            </h2>
            <div
              id={`collapse-${row.id}`}
              class={`accordion-collapse collapse ${index === 0 ? 'show' : ''}`}
              aria-labelledby={`heading-${row.id}`}
              data-bs-parent="#ismAccordion"
            >
              <div class="accordion-body bg-light">
                <div class="mb-3">
                  <span class="badge bg-secondary mb-1">E8 ML1</span>
                  <p class="small text-muted mb-0" set:html={row.e8} />
                </div>
                <div class="mb-3">
                  <span class="badge bg-dark mb-1">SMB1001-L3</span>
                  <p class="small text-muted mb-0" set:html={row.smb} />
                </div>
                <div class="p-3 bg-primary-subtle rounded border-start border-primary border-4">
                  <span class="badge bg-primary mb-2">Our Controls</span>
                  <p class="fw-medium text-dark mb-0 small" set:html={row.controls} />
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <CallToAction />
  </div>
  <BriefingForm hidden={true} />
</BaseLayout>