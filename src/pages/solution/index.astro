---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BriefingForm from '../../components/BriefingForm.astro'; 
import CallToAction from '../../components/CallToAction.astro';

// Compliance mapping data array
const ismMappings = [
  {
    id: "govern",
    domain: "Govern",
    e8: null,
    smb: [
      "Engage a technical support specialist",
      "Purchase and maintain business or cyber insurance",
      "Confidentiality agreement for employees, contractors and third parties",
      "Implement a policy with procedures to manage Invoice Fraud",
      "Implement a visitor register",
      "Implement a cyber security policy",
      "Implement a response plan for cyber related incidents",
      "Implement and maintain a digital asset register",
      "Implement a policy for responsible and secure use of AI technology",
      "Conduct cybersecurity awareness training for all employees"
    ],
    controls: [
      "Provide technical support specialist",
      "Implement a policy with procedures to manage Invoice Fraud",
      "Implement a policy with procedures to manage Invoice Fraud",
      "Implement and maintain a digital asset register"
    ]
  },
  {
    id: "identify",
    domain: "Identify",
    e8: [
      "Application Control",
      "Patch Applications",
      "User Application Hardening",
      "Restrict Administrative Privileges",
      "Patch Operating Systems",
      "Multi-Factor Authentication"
    ],
    smb: [
      "Automatically install tested and approved software updates and patches on all organisation devices",
      "Ensure all servers are updated and patched",
      "Ensure employee accounts do not have administrative privileges",
      "Ensure employees have individual user accounts",
      "Purchase and maintain business or cyber insurance",
      "Implement and maintain a digital asset register"
    ],
    controls: [
      "Provide an MDM and enroll all devices",
      "Remove admin access from user accounts",
      "Create auto update rings"
    ]
  },
  {
    id: "protect",
    domain: "Protect",
    e8: [
      "Application Control",
      "Patch Applications",
      "Restrict Microsoft Office Macros",
      "User Application Hardening",
      "Restrict Administrative Privileges",
      "Patch Operating Systems",
      "Multi-Factor Authentication",
      "Regular Backups"
    ],
    smb: [
      "Install and configure a firewall",
      "Install anti-virus software on all organisation devices",
      "Automatically install tested and approved software updates and patches on all organisation devices",
      "Install TLS certificates on all public internet facing websites",
      "Ensure all servers are updated and patched",
      "Implement Endpoint Detection and Response (EDR)",
      "Ensure strong password hygiene is maintained",
      "Ensure employee accounts do not have administrative privileges",
      "Ensure employees have individual user accounts",
      "Implement a password manager system",
      "Multi-factor authentication (MFA) on all employee email accounts",
      "MFA on all business applications and social media accounts",
      "Ensure Remote Desktop Protocol (RDP) occurs only over Virtual Private Network (VPN) connections",
      "Email Authentication and Anti-Spoofing",
      "Implement a backup and recovery strategy for important digital assets."
    ],
    controls: [
        "Application Control",
        "Restrict Microsoft Office macros",
        "User Application Hardening",
        "Passwordless authentication",
        "Session control / hardening / SSO",
        "Remove admin access from user accounts",
        "Create auto update rings",
        "Configure modern cryptography",
        "Create dedicated JIT admin accounts",
        "Implement backup and recovery strategy"
    ]
  },
  {
    id: "detect",
    domain: "Detect",
    e8: null,
    smb: [
      "Implement Endpoint Detection and Response (EDR)",
      "Email Authentication and Anti-Spoofing"
    ],
    controls: [
      "End-to-end quantum-resistant encryption, active DLP controls, automated data classification, and sanitization protocols."
    ]
  },
  {
    id: "respond",
    domain: "Respond",
    e8: null,
    smb: [
      "Implement a policy with procedures to manage Invoice Fraud",
      "Implement a response plan for cyber related incidents"
    ],
    controls: [
      "Automated patch deployment pipelines, immutable infrastructure builds, zero-trust endpoint control, and daily vulnerability scanning."
    ]
  },
  {
    id: "recover",
    domain: "Recover",
    e8: [
      "Regular Backups"
    ],
    smb: [
      "Implement a backup and recovery strategy for important digital assets",
      "Purchase and maintain business or cyber insurance"
    ],
    controls: [
      "24/7 SOC integration, automated playbook orchestration, continuous telemetry logging, and proactive threat hunting."
    ]
  }
];
---

<BaseLayout title="Solution Mapping - Decoheron">
    <div class="container py-4">
        <!-- Page Header -->
        <div class="row mb-5">
            <div class="col-lg-9">
                <span class="badge bg-primary mb-3 px-3 py-2 text-uppercase fs-6">
                    Compliance & Controls Matrix
                </span>
                <h1 class="display-4 fw-bold text-primary mb-3">
                    ISM Control Alignment & Solution Architecture
                </h1>
                <p class="lead text-subtle fs-5">
                    See how our deterministic controls map across standard Australian government and enterprise frameworks, translating regulatory compliance into operational protection.
                </p>
            </div>
        </div>

        <!-- Solution Matrix Section -->
        <div class="mb-5">
            <div class="d-flex align-items-center justify-content-between mb-4">
                <h2 class="h3 fw-bold text-primary mb-0">Framework Mapping</h2>
                <span class="text-muted fs-6 d-lg-none">(Tap any domain to expand)</span>
            </div>

            <!-- DESKTOP VIEW: Standard Table -->
            <div class="d-none d-lg-block shadow-sm rounded-3 overflow-hidden border border-2 border-secondary-subtle">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark text-uppercase fs-7">
                        <tr>
                            <th scope="col" style="width: 22%;">ISM Function</th>
                            <th scope="col" style="width: 26%;">E8 ML1</th>
                            <th scope="col" style="width: 26%;">SMB1001-L3</th>
                            <th scope="col" class="bg-primary text-white" style="width: 26%;">Our Controls</th>
                        </tr>
                    </thead>
                    <tbody>
                        {ismMappings.map((row) => (
                        <tr>
                            <td class="fw-bold text-primary bg-light" set:html={row.domain} />

                            <td class="text-body-secondary small">
                                {Array.isArray(row.e8) ? (
                                <ul class="mb-0 ps-3">
                                    {row.e8.map((item) => (
                                    <li set:html={item} />
                                    ))}
                                </ul>
                                ) : (
                                <span set:html={row.e8} />
                                )}
                            </td>

                            <td class="text-body-secondary small">
                                {Array.isArray(row.smb) ? (
                                <ul class="mb-0 ps-3">
                                    {row.smb.map((item) => (
                                    <li set:html={item} />
                                    ))}
                                </ul>
                                ) : (
                                <span set:html={row.smb} />
                                )}
                            </td>

                            <td class="bg-primary-subtle fw-medium text-dark border-start border-primary border-3 small">
                                {Array.isArray(row.controls) ? (
                                <ul class="mb-0 ps-3">
                                    {row.controls.map((item) => (
                                    <li set:html={item} />
                                    ))}
                                </ul>
                                ) : (
                                <span set:html={row.controls} />
                                )}
                            </td>
                        </tr>
                        ))}
                    </tbody>
                </table>
            </div>

            <!-- MOBILE / TABLET VIEW: Accordion Cards -->
            <div class="accordion d-lg-none shadow-sm" id="ismAccordion">
                {ismMappings.map((row, index) => (
                <div class="accordion-item border border-secondary-subtle mb-2 rounded-2 overflow-hidden">
                    <h2 class="accordion-header" id={`heading-${row.id}`}>
                        <button
                            class={`accordion-button fw-bold text-primary ${index !== 0 ? 'collapsed' : ''}`}
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target={`#collapse-${row.id}`}
                            aria-expanded={index === 0 ? "true" : "false"}
                            aria-controls={`#collapse-${row.id}`}
                            >
                            {row.domain}
                        </button>
                    </h2>
                    <div
                        id={`collapse-${row.id}`}
                        class={`accordion-collapse collapse ${index === 0 ? 'show' : ''}`}
                        aria-labelledby={`heading-${row.id}`}
                        data-bs-parent="#ismAccordion"
                        >
                        <div class="accordion-body bg-light">
                            <div class="mb-3">
                                <span class="badge bg-secondary mb-1">E8 ML1</span>
                                {Array.isArray(row.e8) ? (
                                <ul class="small text-muted mb-0 ps-3">
                                    {row.e8.map((item) => (
                                    <li set:html={item} />
                                    ))}
                                </ul>
                                ) : (
                                <p class="small text-muted mb-0" set:html={row.e8} />
                                )}
                            </div>

                            <div class="mb-3">
                                <span class="badge bg-dark mb-1">SMB1001-L3</span>
                                {Array.isArray(row.smb) ? (
                                <ul class="small text-muted mb-0 ps-3">
                                    {row.smb.map((item) => (
                                    <li set:html={item} />
                                    ))}
                                </ul>
                                ) : (
                                <p class="small text-muted mb-0" set:html={row.smb} />
                                )}
                            </div>

                            <div class="p-3 bg-primary-subtle rounded border-start border-primary border-4">
                                <span class="badge bg-primary mb-2">Our Controls</span>
                                {Array.isArray(row.controls) ? (
                                <ul class="fw-medium text-dark mb-0 small ps-3">
                                    {row.controls.map((item) => (
                                    <li set:html={item} />
                                    ))}
                                </ul>
                                ) : (
                                <p class="fw-medium text-dark mb-0 small" set:html={row.controls} />
                                )}
                            </div>
                        </div>
                    </div>
                </div>
                ))}
            </div>
        </div>

        <CallToAction />
    </div>
    <BriefingForm hidden={true} />
</BaseLayout>
