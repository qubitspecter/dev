---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BriefingForm from '../../components/BriefingForm.astro';
import CallToAction from '../../components/CallToAction.astro';
import ControlCards from '../../components/ControlCards.astro';
import ControlModal from '../../components/ControlModal.astro';
import { matrixData } from '../../data/controls';
const allControls = matrixData.flatMap((cat) => cat.controls);
---

<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>VeriState Compliance Matrix</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">

  <style>
    :root {
      --font-family-sans: Arial, "Helvetica Neue", Helvetica, sans-serif;
      --hero-gradient-pass: linear-gradient(135deg, rgba(0, 71, 171, 0.50) 0%, rgba(30, 120, 255, 0.22) 100%);
      --hero-gradient-fail: linear-gradient(135deg, rgba(110, 0, 10, 0.60) 0%, rgba(170, 15, 35, 0.28) 100%);
      --card-transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    }

    body {
      font-family: var(--font-family-sans);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    .matrix-card {
      transition: var(--card-transition);
      border-radius: 1.25rem;
      position: relative;
      overflow: hidden;
    }

    .matrix-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 1rem 2.5rem rgba(0, 0, 0, 0.12) !important;
    }

    .hero-graphic-box {
      width: 100%;
      min-height: 140px;
      padding: 2.5rem 1rem 1.25rem;
      border-radius: 1rem;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 0.75rem;
      text-align: center;
      position: relative;
    }

    .hero-graphic-box.status-pass {
      background: var(--hero-gradient-pass);
      border: 1px solid rgba(25, 135, 84, 0.2);
    }

    .hero-graphic-box.status-fail {
      background: var(--hero-gradient-fail);
      border: 1px solid rgba(220, 53, 69, 0.2);
    }

    .hero-icon-wrapper {
      width: 76px;
      height: 76px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 2.25rem;
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.08);
      background: rgba(255, 255, 255, 0.9);
      backdrop-filter: blur(8px);
    }

    .bullet-list-group .list-group-item {
      padding: 0.75rem 0.5rem;
      background: transparent;
      border-left: none;
      border-right: none;
      border-top: none;
      font-size: 0.925rem;
      display: flex;
      align-items: flex-start;
      gap: 0.75rem;
    }

    .bullet-list-group .list-group-item:last-child {
      border-bottom: none;
    }

    .bullet-icon {
      font-size: 1.1rem;
      line-height: 1.2;
      flex-shrink: 0;
      margin-top: 2px;
    }

    .glass-panel {
      background: rgba(255, 255, 255, 0.7);
      backdrop-filter: blur(12px);
      border: 1px solid rgba(0, 0, 0, 0.08);
    }

    .control-link {
      color: inherit;
      text-decoration: underline dotted;
      text-underline-offset: 4px;
      cursor: pointer;
    }

    .control-link:hover { text-decoration-style: solid; }

    .control-modal .modal-content {
      border-radius: 1.25rem;
      overflow: hidden;
      box-shadow: 0 1rem 2.5rem rgba(0, 0, 0, 0.18);
    }

    .control-modal .modal-content.status-pass { border: 1px solid rgba(0, 71, 171, 0.35); }
    .control-modal .modal-content.status-fail { border: 1px solid rgba(220, 53, 69, 0.35); }

    .control-modal .modal-header {
      gap: 0.9rem;
      padding: 1.25rem 1.5rem;
      border-bottom: none;
    }

    .status-pass .modal-header { background: var(--hero-gradient-pass); }
    .status-fail .modal-header { background: var(--hero-gradient-fail); }

    .control-modal .modal-body { padding: 1.5rem; }
    .status-pass .modal-body { background: linear-gradient(180deg, rgba(0, 71, 171, 0.07) 0%, rgba(30, 120, 255, 0.02) 100%); }
    .status-fail .modal-body { background: linear-gradient(180deg, rgba(110, 0, 10, 0.07) 0%, rgba(170, 15, 35, 0.02) 100%); }

    .control-modal .modal-footer { border-top: none; padding: 0 1.5rem 1.5rem; }
    .status-pass .modal-footer { background: rgba(30, 120, 255, 0.02); }
    .status-fail .modal-footer { background: rgba(170, 15, 35, 0.02); }

    .vs-map-h { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--bs-secondary-color); margin: 1rem 0 0.5rem; }
    .vs-map-h:first-child { margin-top: 0; }
    .vs-map-list { list-style: none; padding: 0; margin: 0 0 0.5rem; font-size: 0.925rem; }
    .vs-map-list li { padding: 0.25rem 0; }
  </style>
</head>

<body class="bg-body-tertiary">
  <main class="container-fluid px-lg-5 py-4 flex-grow-1">
    <div class="mb-4 text-center">
      <h1 class="fw-bold display-6 mb-2">Technical Control Chains, Made Intuitive</h1>
      <p>Each control is built around an idea you can picture...</p>
      <p>The result is protection you can understand at a glance...</p>
    </div>

    <!-- Dynamic Category Grid -->
    <div class="row row-cols-1 row-cols-md-2 g-4">
      {matrixData.map((category) => (
        <div class="col">
          <div class="card h-100 border-0 shadow-sm matrix-card bg-body">
            <div class="card-body p-4 d-flex flex-column">
              <div class={`hero-graphic-box status-${category.status} mb-3`}>
                <div class="hero-icon-wrapper text-success">
                  <i class={`bi ${category.icon}`}></i>
                </div>
                <div>
                  <h3 class="fw-bold fs-4 mb-3">{category.title}</h3>
                </div>
              </div>

              <ul class="list-group list-group-flush bullet-list-group flex-grow-1">
                {category.controls.map((control) => {
                  const targetModal = `#modal-${control.id.replace(/\./g, '-')}`;
                  return (
                    <li class="list-group-item" id={control.id}>
                      <i class="bi bi-check-circle-fill text-success bullet-icon"></i>
                      <span>
                        <a 
                          class="control-link" 
                          href={targetModal} 
                          data-bs-toggle="modal" 
                          role="button"
                        >
                          <strong>{control.title}</strong>
                        </a>
                      </span>
                    </li>
                  );
                })}
              </ul>
            </div>
          </div>
        </div>
      ))}
    </div>
  </main>

  <footer class="border-top glass-panel py-4 mt-5">
    <div class="container-fluid px-lg-5 text-center text-md-start">
      <p class="text-body-secondary mb-0 small">
        © 2026 <strong>VeriState by Decoheron</strong> • Deterministic Compliance Attestation
      </p>
    </div>
  </footer>



  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
---
<BaseLayout title="Solutions - Deterministic Security & Verifiable Compliance - Decoheron">

    <div class="dh-page">
        <section class="pg-hero">
            <div class="pg-wrap pg-hero__split">
                <div>
                    <h1 class="ph-hero__title">
                        <span>Cybersecurity.</span><br>
                        <span>Intuitive & Verifiable.</span>
                    </h1>
                    <p>Each control is built around an idea you can picture: only you can sign in as you, only approved apps can run, nobody holds the keys all the time, and your backups sit where a thief can’t reach them.</p>
                    <p>The result is protection you can understand at a glance. Every control either passes or fails without blurry security scores, leaving zero guesswork about where you stand.</p>
                </div>
            </div>
        </section>

                <section class="pg-band pg-band--white">
            <div class="pg-wrap">
        <!-- Framework Alignment -->
        <div class="row g-4">
            <div class="col-12">
                <h2 class="h3 fw-bold text-primary mb-1">
                    Framework Alignment
                </h2>
                <p class="text-secondary fw-medium mb-0">Deterministic controls, mapped against the standards insurers, regulators, and forensic examiners actually apply</p>
            </div>
            <!-- Essential Eight -->
            <div class="col-md-4">
                <div class="card bg-light h-100 border border-2 border-secondary shadow-lg p-4 rounded-3">
                    <div class="mb-3">
                        <h3 class="h4 fw-bold text-primary mb-1">Essential Eight</h3>
                        <p class="text-secondary mb-0 fw-medium">Insurer & Regulator Baseline</p>
                    </div>
                    <p class="text-body mb-3">
                        We deploy to Maturity Level 1 as a floor, not a ceiling, because it remains the reference point underwriters and regulators default to when assessing whether reasonable controls were in place.
                    </p>
                    <p class="text-body mb-0">
                        Essential Eight remains an important Australian baseline. We align its controls with broader ISM guidance and additional safeguards appropriate to each organisation’s risks, systems and obligations.
                    </p>
                </div>
            </div>
            <!-- SMB1001 -->
            <div class="col-md-4">
                <div class="card bg-light h-100 border border-2 border-secondary shadow-lg p-4 rounded-3">
                    <div class="mb-3">
                        <h3 class="h4 fw-bold text-primary mb-1">SMB1001 Level 3 (Gold)</h3>
                        <p class="text-secondary mb-0 fw-medium">Director-Grade Standard of Care</p>
                    </div>
                    <p class="text-body mb-3">
                        Purpose-built for organisations of your size, SMB1001 Gold gives individual directors an independently published, third-party standard to point to rather than an internal policy of the board's own making.
                    </p>
                    <p class="text-body mb-0">
                        We exceed Gold specifically in passkey enforcement, application control, and zero standing admin access the control areas examined first in a post-incident forensic review.
                    </p>
                </div>
            </div>
            <!-- Verifiable Compliance -->
            <div class="col-md-4">
                <div class="card h-100 bg-light border border-2 border-secondary shadow-lg p-4 rounded-3">
                    <div class="mb-3">
                        <h3 class="h4 fw-bold text-primary mb-1">Continuous Verification</h3>
                        <p class="text-secondary mb-0 fw-medium">Evidence, Not Attestation</p>
                    </div>
                    <p class="text-body mb-3">
                        Framework alignment on paper is a starting position, not an outcome. Controls are technically enforced, not policy-only, and their operation is verified on an ongoing basis.
                    </p>
                    <p class="text-body mb-0">
                        The full ISM / Essential Eight / SMB1001 control mapping, with our specific implementation against each, is available for your broker, auditor, or counsel on request.
                    </p>
                </div>
            </div>
        </div>
            </div>
        </section>
