---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BriefingForm from '../../components/BriefingForm.astro';

// Illustrative sample only. Not a real client record.
// `ok: false` is the starting state; the animation then remediates each failing control.
const source = [
    {
        name: 'Deterministic Access',
        icon: 'fingerprint',
        items: [
            { label: 'Phishing-Resistant Sign-in', ok: true },
            { label: 'Device Compliance', ok: true },
            { label: 'Self-Service Risk Recovery', ok: true },
            { label: 'Bypass Prevention', ok: true },
            { label: 'Session Protection', ok: true },
            { label: 'Secure Enrolment', ok: true },
        ],
    },
    {
        name: 'Zero Admin',
        icon: 'admin',
        items: [
            { label: 'Delegated Tasks', ok: true },
            { label: 'Just-in-Time Privilege', ok: true },
            { label: 'Approval Flow', ok: true },
            { label: 'Admin Safeguards', ok: true },
            { label: 'Local Admin Rights', ok: true },
            { label: 'Break the Glass', ok: true },
        ],
    },
    {
        name: 'Execution Control',
        icon: 'terminal',
        items: [
            { label: 'App Control', ok: true },
            { label: 'Browser Extensions', ok: true },
            { label: 'Cloud App Consent', ok: true },
            { label: 'Attack Surface Reduction', ok: true },
            { label: 'Advanced Attack Defence', ok: true },
            { label: 'Auto-Remediation', ok: true },
        ],
    },
    {
        name: 'Hardened Environment',
        icon: 'shield',
        items: [
            { label: 'Backups', ok: true },
            { label: 'Email Security', ok: false },
            { label: 'Device Encryption', ok: false },
            { label: 'Patch Management', ok: false },
            { label: 'Tamper Protection', ok: false },
            { label: 'File Sharing', ok: true },
        ],
    },
];

// Zero tolerance: a category fails if any control in it fails.
// Failing controls are fixed one after another, in page order, after a short hold on the starting state.
const HOLD = 1.6;
const STEP = 0.6;
let fixes = 0;
const categories = source.map((cat) => {
    const items = cat.items.map((item) => ({ ...item, fixAt: item.ok ? 0 : HOLD + STEP * fixes++ }));
    const failing = items.filter((i) => !i.ok);
    const doneAt = failing.length ? Math.max(...failing.map((i) => i.fixAt)) + 0.4 : 0;
    return { ...cat, items, failed: failing.length > 0, doneAt };
});
---
<BaseLayout title="VeriState Compliance Matrix - Decoheron">
    <section class="vs-stage">
        <div class="vs-wrap">
            <div class="vs-top">
                <div>
                    <h1 class="vs-title">VeriState Compliance Matrix</h1>
                    <p class="vs-sub">Compliance is assessed on a strict zero-tolerance basis (100% adherence is required to pass).</p>
                </div>
                <button type="button" class="vs-replay" id="vs-replay">Replay</button>
            </div>

            <div class="vs-grid vs-run" id="vs-matrix">
                {categories.map((cat, c) => (
                    <section
                        class:list={['vs-card', { 'vs-card--failed': cat.failed }]}
                        style={`--done:${cat.doneAt}s`}
                        aria-labelledby={`vs-cat-${c}`}
                    >
                        <div class="vs-banner">
                            {cat.failed && <div class="vs-banner__alert"></div>}
                            <div class="vs-badge" aria-hidden="true">
                                <svg viewBox="0 0 24 24" class="vs-icon vs-icon--ok">
                                    {cat.icon === 'fingerprint' && (
                                        <>
                                            <path d="M12 4a8 8 0 0 0-8 8v1.5" />
                                            <path d="M20 12.5V12a8 8 0 0 0-8-8" />
                                            <path d="M8 13.5V12a4 4 0 0 1 8 0v2.5a6 6 0 0 1-1.2 3.6" />
                                            <path d="M12 12v3a9 9 0 0 1-2 5.6" />
                                            <path d="M7.5 17.5A12 12 0 0 0 8 15" />
                                        </>
                                    )}
                                    {cat.icon === 'admin' && (
                                        <>
                                            <circle cx="9.5" cy="7.5" r="3.5" />
                                            <path d="M3 20v-1.5A5.5 5.5 0 0 1 8.5 13H10" />
                                            <circle cx="17" cy="17" r="2.2" />
                                            <path d="M17 12.8v1.2M17 20v1.2M12.8 17H14M20 17h1.2M14 14l.9.9M19.1 19.1l.9.9M20 14l-.9.9M14.9 19.1l-.9.9" />
                                        </>
                                    )}
                                    {cat.icon === 'terminal' && (
                                        <>
                                            <rect x="3" y="4" width="18" height="14" rx="2.5" />
                                            <path d="M7 9l3 2.5L7 14" />
                                            <path d="M12.5 14.5H15" />
                                        </>
                                    )}
                                    {cat.icon === 'shield' && (
                                        <>
                                            <path d="M12 3l7 2.6v5.4c0 4.4-2.9 8-7 10-4.1-2-7-5.6-7-10V5.6z" />
                                            <path d="M8.8 12l2.4 2.4 4.2-4.6" class="vs-shield-check" />
                                        </>
                                    )}
                                </svg>
                                {cat.failed && (
                                    <svg viewBox="0 0 24 24" class="vs-icon vs-icon--bad">
                                        <path d="M12 3l7 2.6v5.4c0 4.4-2.9 8-7 10-4.1-2-7-5.6-7-10V5.6z" />
                                        <path d="M12 8.5v4M12 15.5v.1" />
                                    </svg>
                                )}
                            </div>
                            <h2 class="vs-card__title" id={`vs-cat-${c}`}>
                                {cat.name}
                                {cat.failed && <span class="vs-sr">: initially failing, now passing</span>}
                            </h2>
                        </div>

                        <ul class="vs-items">
                            {cat.items.map((item) => (
                                <li class="vs-item" style={item.ok ? undefined : `--fix:${item.fixAt}s`}>
                                    <span class="vs-state" aria-hidden="true">
                                        <svg viewBox="0 0 16 16" class="vs-state__ok">
                                            <circle cx="8" cy="8" r="8" />
                                            <path d="M4.6 8.3l2.3 2.3 4.5-4.7" />
                                        </svg>
                                        {!item.ok && (
                                            <svg viewBox="0 0 16 16" class="vs-state__bad">
                                                <circle cx="8" cy="8" r="8" />
                                                <path d="M5.4 5.4l5.2 5.2M10.6 5.4l-5.2 5.2" />
                                            </svg>
                                        )}
                                    </span>
                                    <span class="vs-item__label">{item.label}</span>
                                    <span class="vs-sr">: {item.ok ? 'pass' : 'initially failing, now passing'}</span>
                                </li>
                            ))}
                        </ul>
                    </section>
                ))}
            </div>
            <p class="vs-caption">Illustrative sample matrix. Not a real client record.</p>
        </div>
    </section>

    <BriefingForm />
</BaseLayout>

<script>
    const matrix = document.getElementById('vs-matrix');
    document.getElementById('vs-replay')?.addEventListener('click', () => {
        if (!matrix) return;
        matrix.classList.remove('vs-run');
        void matrix.offsetWidth; // force reflow so the animations restart
        matrix.classList.add('vs-run');
    });
</script>

<style>
    .vs-stage {
        --vs-ok: #1E8449;
        --vs-bad: #D6293E;
        --vs-ink: #1B1F27;
        background: #F6F7F9;
        padding: clamp(1.5rem, 4vw, 3rem) 1rem;
        color: var(--vs-ink);
    }
    .vs-wrap { max-width: 1240px; margin: 0 auto; }

    .vs-top {
        display: flex;
        flex-wrap: wrap;
        align-items: flex-end;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 1.25rem;
    }
    .vs-title { margin: 0; font-size: clamp(1.5rem, 3.5vw, 2rem); font-weight: 700; }
    .vs-sub { margin: 0.35rem 0 0; font-size: 0.9375rem; color: #4B5563; }
    .vs-replay {
        padding: 0.45rem 1.1rem;
        border: 1px solid var(--bs-secondary);
        border-radius: 4px;
        background: transparent;
        color: var(--bs-secondary);
        font-weight: 600;
        font-size: 0.9375rem;
    }
    .vs-replay:hover { background: var(--bs-secondary); color: #fff; }

    .vs-grid { display: grid; gap: 1.25rem; }
    @media (min-width: 860px) {
        .vs-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }

    .vs-card {
        background: #fff;
        border-radius: 12px;
        padding: 1rem;
        box-shadow: 0 1px 3px rgba(15, 23, 42, 0.08);
    }

    /* Banner: blue by default; failed categories carry a red layer that fades out when fixed */
    .vs-banner {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.65rem;
        padding: 1.5rem 1rem 1.25rem;
        border: 1px solid #A9C0E6;
        border-radius: 10px;
        background: linear-gradient(90deg, #86A5D6, #C5D9F8);
        overflow: hidden;
    }
    .vs-banner__alert {
        position: absolute;
        inset: 0;
        background: linear-gradient(90deg, #AE6B6F, #E6B9BF);
    }
    .vs-badge, .vs-card__title { position: relative; }
    .vs-badge {
        width: 2.9rem;
        height: 2.9rem;
        border-radius: 50%;
        background: #fff;
        display: grid;
        place-items: center;
    }
    .vs-icon {
        grid-area: 1 / 1;
        width: 1.5rem;
        height: 1.5rem;
        fill: none;
        stroke-width: 1.8;
        stroke-linecap: round;
        stroke-linejoin: round;
    }
    .vs-icon--ok { stroke: var(--vs-ok); }
    .vs-icon--bad { stroke: var(--vs-bad); }
    .vs-card--failed .vs-icon--ok { opacity: 0; }
    .vs-card__title { margin: 0; font-size: 1.0625rem; font-weight: 600; text-align: center; }

    /* Rows */
    .vs-items { list-style: none; margin: 0.75rem 0 0; padding: 0 0.25rem; }
    .vs-item {
        display: flex;
        align-items: center;
        gap: 0.65rem;
        padding: 0.55rem 0;
        border-top: 1px solid #E5E7EB;
        font-size: 0.875rem;
        font-weight: 600;
    }
    .vs-item:first-child { border-top: 0; }
    .vs-state { position: relative; flex: none; width: 1rem; height: 1rem; display: grid; }
    .vs-state svg { grid-area: 1 / 1; width: 100%; height: 100%; }
    .vs-state circle { stroke: none; }
    .vs-state path { fill: none; stroke: #fff; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
    .vs-state__ok circle { fill: var(--vs-ok); }
    .vs-state__bad circle { fill: var(--vs-bad); }

    /* Failing rows start red; each flips to green when its fix lands */
    .vs-item[style] .vs-state__ok { opacity: 0; }

    .vs-run .vs-banner__alert { animation: vs-fade-out 0.7s ease forwards; animation-delay: var(--done); }
    .vs-run .vs-icon--bad { animation: vs-fade-out 0.5s ease forwards; animation-delay: var(--done); }
    .vs-run .vs-card--failed .vs-icon--ok { animation: vs-fade-in 0.5s ease forwards; animation-delay: var(--done); }
    .vs-run .vs-item[style] .vs-state__ok { animation: vs-fade-in 0.35s ease forwards; animation-delay: var(--fix); }
    .vs-run .vs-item[style] .vs-state__bad { animation: vs-fade-out 0.35s ease forwards; animation-delay: var(--fix); }

    .vs-sr {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
    }
    .vs-shield-check { stroke: var(--vs-ok); }

    @keyframes vs-fade-out { to { opacity: 0; } }
    @keyframes vs-fade-in { to { opacity: 1; } }

    /* Reduced motion: show the end state (everything passing) with no animation */
    @media (prefers-reduced-motion: reduce) {
        .vs-banner__alert, .vs-icon--bad, .vs-state__bad { display: none; }
        .vs-run .vs-card--failed .vs-icon--ok, .vs-run .vs-item[style] .vs-state__ok { animation: none; }
        .vs-card--failed .vs-icon--ok, .vs-item[style] .vs-state__ok { opacity: 1; }
    }

    .vs-caption { margin: 1.25rem 0 0; font-size: 0.875rem; color: #4B5563; text-align: center; }
</style>
