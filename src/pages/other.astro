    <BriefingForm />
</BaseLayout>

<style>
  .dh-hero, .dh-facts {
    --dh-navy: #0A1B6B;
    --dh-ink: #050D2E;
    --dh-indigo: #0310A4;
    --dh-paper: #F5F6FA;
    --dh-gold: #D8AE4E;
    --dh-serif: "Newsreader", "Iowan Old Style", Georgia, serif;
    --dh-sans: "Hanken Grotesk", system-ui, -apple-system, "Segoe UI", sans-serif;
    font-family: var(--dh-sans);
    -webkit-font-smoothing: antialiased;
  }
  .dh-hero *, .dh-facts * { box-sizing: border-box; }

  /* Hero */
  .dh-hero {
    background: var(--dh-navy);
    color: #fff;
    padding: clamp(3rem, 7vw, 6.5rem) 1.5rem;
  }
  .dh-hero__inner {
    max-width: 1180px;
    margin: 0 auto;
    display: grid;
    gap: clamp(2.5rem, 5vw, 4.5rem);
    align-items: center;
  }
  @media (min-width: 960px) {
    .dh-hero__inner { grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); }
  }

  .dh-hero__title {
    margin: 0;
    font-family: var(--dh-serif);
    font-weight: 400;
    font-size: clamp(2.25rem, 4.6vw, 3.75rem);
    line-height: 1.05;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }
  .dh-hero__title span { display: block; }
  .dh-hero__title span + span { color: rgba(255, 255, 255, 0.6); margin-top: 0.15em; }
  .dh-hero__title + .dh-hero__lede { margin-top: 1.75rem; }

  .dh-hero__lede {
    margin: 1.25rem 0 0;
    max-width: 34rem;
    font-size: 1.125rem;
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.84);
  }

  .dh-hero__actions {
    margin-top: 2.25rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.875rem;
  }
  .dh-btn {
    display: inline-block;
    padding: 0.9rem 1.5rem;
    border-radius: 4px;
    font: 600 1rem/1.2 var(--dh-sans);
    text-decoration: none;
    border: 1px solid transparent;
    transition: background-color 0.15s ease, border-color 0.15s ease;
  }
  .dh-btn--primary { background: var(--dh-gold); color: var(--dh-ink); }
  .dh-btn--primary:hover { background: #E4BD62; }
  .dh-btn--secondary { color: #fff; border-color: rgba(255, 255, 255, 0.45); }
  .dh-btn--secondary:hover { border-color: #fff; background: rgba(255, 255, 255, 0.06); }
  @media (max-width: 520px) { .dh-btn { width: 100%; text-align: center; } }
  .dh-btn:focus-visible { outline: 3px solid var(--dh-gold); outline-offset: 3px; }

  /* VeriState panel (static) */
  .dh-panel {
    margin: 0;
    background: #F6F7F9;
    color: var(--dh-ink);
    border-radius: 10px;
    padding: 1rem clamp(0.6rem, 2vw, 1rem) 1rem;
    box-shadow: 0 24px 48px -24px rgba(0, 0, 0, 0.55);
  }
  .dh-panel__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.25rem 1rem;
    padding: 0 0.35rem 0.75rem;
  }
  .dh-panel__title { margin: 0; font-size: 1rem; font-weight: 700; color: var(--dh-ink); }
  .dh-panel__sample { font-size: 0.8125rem; color: #4B5563; }

  .dh-tiles { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.65rem; }
  .dh-tile { background: #fff; border-radius: 8px; padding: 0.55rem; box-shadow: 0 1px 2px rgba(15, 23, 42, 0.08); }

  .dh-tile__banner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    padding: 1.6rem 0.75rem 1.4rem;
    border: 1px solid #A9C0E6;
    border-radius: 7px;
    background: linear-gradient(90deg, #86A5D6, #C5D9F8);
  }
  .dh-tile__badge {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 50%;
    background: #fff;
  }
  .dh-ico {
    width: 1.4rem;
    height: 1.4rem;
    fill: none;
    stroke: #1E8449;
    stroke-width: 1.9;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .dh-tile__title { margin: 0; font-size: 0.9375rem; font-weight: 600; line-height: 1.25; text-align: center; color: var(--dh-ink); }

  .dh-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* Fact strip */
  .dh-facts {
    background: var(--dh-paper);
    color: var(--dh-ink);
    padding: clamp(2.5rem, 5vw, 4rem) 1.5rem;
  }
  .dh-facts__inner {
    max-width: 1180px;
    margin: 0 auto;
    display: grid;
    gap: 2.25rem;
  }
  @media (min-width: 800px) {
    .dh-facts__inner { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2.5rem; }
  }
  .dh-fact { border-top: 2px solid var(--dh-navy); padding-top: 1.1rem; }
  .dh-fact__figure {
    margin: 0;
    font-family: var(--dh-serif);
    font-weight: 400;
    font-size: clamp(2.25rem, 4vw, 3.25rem);
    line-height: 1.05;
    letter-spacing: -0.01em;
    color: var(--dh-navy);
  }
  .dh-fact__text { margin: 0.7rem 0 0; max-width: 30rem; font-size: 1rem; line-height: 1.55; color: #2A3358; }
</style>
