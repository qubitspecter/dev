---
import BaseLayout from '../layouts/BaseLayout.astro';
import BriefingForm from '../components/BriefingForm.astro';
import ControlCards from '../components/ControlCards.astro';
import { icon, controls } from '../data/controls';

// Illustrative VeriState matrix for the hero. Not a real client record.
const matrix = [
    { name: 'Deterministic Access', icon: 'fingerprint' },
    { name: 'Zero Admin', icon: 'admin' },
    { name: 'Execution Control', icon: 'terminal' },
    { name: 'Hardened Environment', icon: 'shield' },
];

const trust = [
    { icon: 'award', label: 'SMB1001 Silver certified' },
    { icon: 'shieldCheck', label: 'Our own environment at ASD Essential Eight ML2' },
    { icon: 'cloud', label: 'Microsoft Cloud Solution Provider' },
    { icon: 'users', label: 'Works with your existing MSP' },
];

const questions = [
    'Can we show our controls are working today, not just configured?',
    'Would we pass an audit this week?',
    'What would we show our insurer after an incident?',
    'What do we tell clients who ask how their information is protected?',
];

const pillars = [
    { icon: 'lock', name: 'Enforced', text: 'Policy is applied, not recommended.' },
    { icon: 'checkCircle', name: 'Tested', text: 'Each control is checked against its expected outcome.' },
    { icon: 'report', name: 'Evidenced', text: 'Results are recorded in signed, timestamped reports.' },
    { icon: 'clipboard', name: 'Audit-ready', text: 'Mapped to the ASD Essential Eight, the new ASD Essentials and SMB1001.' },
];

// Five-segment ring: one segment per control, Veristate in the centre.
const ringC = 120;
const ringR = 88;
const ringPt = (deg: number): [number, number] => [
    ringC + ringR * Math.cos((deg * Math.PI) / 180),
    ringC + ringR * Math.sin((deg * Math.PI) / 180),
];
const ringSegs = controls.map((_, i) => {
    const a0 = -90 + i * 72 + 3;
    const a1 = -90 + (i + 1) * 72 - 3;
    const [x0, y0] = ringPt(a0);
    const [x1, y1] = ringPt(a1);
    const [tx, ty] = ringPt((a0 + a1) / 2);
    return {
        n: i + 1,
        d: `M${x0.toFixed(2)} ${y0.toFixed(2)}A${ringR} ${ringR} 0 0 1 ${x1.toFixed(2)} ${y1.toFixed(2)}`,
        tx: tx.toFixed(2),
        ty: ty.toFixed(2),
    };
});

const comparison = [
    ['Periodic security reviews', 'Scheduled, repeatable control verification'],
    ['Best-effort configuration', 'Deterministic controls'],
    ['Subjective maturity opinions', 'Signed, timestamped evidence'],
    ['New tools to buy and manage', 'The Microsoft security you already own'],
    ['Open-ended consulting hours', 'Fixed-scope, fixed-price phases'],
    ['"Trust us."', '"Here\'s the evidence."'],
];

const steps = [
    { name: 'Assess', text: 'A review of your Microsoft environment against the ASD Essential &, ASD Essentials, SMB1001, with a roadmap to compliance.' },
    { name: 'Remediate', text: 'A programme of work that takes your environment to an evidenced, audit-ready state.' },
     { name: 'Consolidate', text: 'A programme of work to maximise the value of your security investments.' },   
    { name: 'Maintain', text: 'An ongoing retainer that keeps controls working, with regular Veristate™ reporting.' },
];

const mspPoints = [
    'Clear division of responsibilities, agreed up front',
    'Security controls designed and verified by specialists',
    'Evidence reporting your MSP can rely on too',
    'Fewer incidents to chase once controls are enforced',
];

const industries = [
    {
        icon: 'scales',
        name: 'Legal firms',
        text: 'Protect client confidentiality and privilege, and show clients and insurers exactly how their information is secured.',
    },
    {
        icon: 'calculator',
        name: 'Accounting firms',
        text: 'Secure client financial data and practice systems, with evidence to support your privacy and professional obligations.',
    },
    {
        icon: 'chart',
        name: 'Wealth management firms',
        text: 'In 2026 the Federal Court imposed the first civil penalty on an AFS licensee for cyber security failures. Give your board and responsible managers evidence that reasonable steps have been taken.',
    },
];
---

<BaseLayout title="Decoheron - Outcome Focused Cyber Security">

<!-- 1. Hero -->
<section class="dh-hero" aria-labelledby="dh-hero-title">
  <div class="dh-hero__inner">
    <div>
      <p class="dh-eyebrow">Cyber security for small to medium business</p>
      
        <!-- Specialising in legal, accounting, and wealth management firms.-->
      <h1 class="ph-hero__title">
        <span>Security you can prove,</span><br>
        <span>not opinions you can't prove.</span>
      </h1>
      <p class="dh-hero__lede">
        Decoheron turns the Microsoft security your business already owns into controls aligned to both the ASD Essential Eight and the new ASD Essentials, enforced, tested and evidenced. Our controls are deterministic, meaning each one either works or it doesn't, and we give you signed evidence showing which.
      </p>
      <p class="dh-hero__lede">
        No subjective maturity opinions. No best-effort recommendations. Controls that work, and the evidence to show it.
      </p>

      <div class="dh-hero__actions">
        <a class="dh-btn dh-btn--primary" href="#briefing">Book a Call</a>
        <a class="dh-btn dh-btn--secondary" href="/solution">See How It Works</a>
      </div>
      {/* PREPARER NOTE: confirm assessment duration before publishing. Intended line: "Fixed-fee assessment. [X] days. A costed roadmap you keep." The duration is left out of the live text until confirmed. */}
      
    </div>

    <!-- Hero matrix panel, switched off. Restore the two-column .dh-hero__inner grid in the styles if this is brought back.
    <figure class="dh-panel" aria-label="Illustrative VeriState compliance matrix">
      <div class="dh-panel__head">
        <h2 class="dh-panel__title">VeriState compliance matrix</h2>
        <span class="dh-panel__sample">Illustrative sample</span>
      </div>
      <div class="dh-tiles">
        {matrix.map((cat) => (
          <section class="dh-tile" aria-label={cat.name}>
            <div class="dh-tile__banner">
              <div class="dh-tile__badge" aria-hidden="true">
                <svg viewBox="0 0 24 24" class="dh-ico">
                  {cat.icon === 'fingerprint' && (<>
                    <path d="M12 4a8 8 0 0 0-8 8v1.5" />
                    <path d="M20 12.5V12a8 8 0 0 0-8-8" />
                    <path d="M8 13.5V12a4 4 0 0 1 8 0v2.5a6 6 0 0 1-1.2 3.6" />
                    <path d="M12 12v3a9 9 0 0 1-2 5.6" />
                    <path d="M7.5 17.5A12 12 0 0 0 8 15" />
                  </>)}
                  {cat.icon === 'admin' && (<>
                    <circle cx="9.5" cy="7.5" r="3.5" />
                    <path d="M3 20v-1.5A5.5 5.5 0 0 1 8.5 13H10" />
                    <circle cx="17" cy="17" r="2.2" />
                    <path d="M17 12.8v1.2M17 20v1.2M12.8 17H14M20 17h1.2M14 14l.9.9M19.1 19.1l.9.9M20 14l-.9.9M14.9 19.1l-.9.9" />
                  </>)}
                  {cat.icon === 'terminal' && (<>
                    <rect x="3" y="4" width="18" height="14" rx="2.5" />
                    <path d="M7 9l3 2.5L7 14" />
                    <path d="M12.5 14.5H15" />
                  </>)}
                  {cat.icon === 'shield' && (<>
                    <path d="M12 3l7 2.6v5.4c0 4.4-2.9 8-7 10-4.1-2-7-5.6-7-10V5.6z" />
                    <path d="M8.8 12l2.4 2.4 4.2-4.6" />
                  </>)}
                </svg>
              </div>
              <h3 class="dh-tile__title">{cat.name}<span class="dh-sr">: pass</span></h3>
            </div>
          </section>
        ))}
      </div>
    </figure>
    -->
  </div>
</section>

<!-- 2. Trust bar -->
{/* PREPARER NOTE: update "SMB1001 Silver" to "SMB1001 Gold" once the independent audit is complete. Add "ASD Cyber Security Partnership Programme Network Partner" only once membership is confirmed. Add certification badge images if the certifying bodies permit their use. */}
<section class="dh-section dh-section--tight dh-section--paper" aria-label="Credentials">
  <ul class="dh-wrap dh-trust">
    {trust.map((t) => (
      <li class="dh-trust__item">
        <span class="dh-trust__icon" set:html={icon(t.icon)} />
        <span>{t.label}</span>
      </li>
    ))}
  </ul>
</section>

<!-- 3. The problem -->
<section class="dh-section" aria-labelledby="dh-problem-title">
  <div class="dh-wrap dh-split">
    <div>
      <h2 class="dh-h2" id="dh-problem-title">Most businesses have the tools. Few can prove they work.</h2>
      <p class="dh-body">
        Your firm has likely already invested in Microsoft 365 security. But when a client, insurer or auditor asks, can you answer these with confidence?
      </p>
    </div>
    <div>
      <ul class="dh-questions">
        {questions.map((q) => (
          <li>
            <span class="dh-questions__icon" set:html={icon('question')} />
            <span>{q}</span>
          </li>
        ))}
      </ul>
      <p class="dh-body dh-body--lead">
        Most security programs answer these with a report full of opinions. We answer them with evidence.
      </p>
    </div>
  </div>
</section>

<!-- 4. Why it matters now -->
{/* PREPARER NOTE: if adding a claims-denial statistic, cite the primary source on the page. Keep legal and insurance statements framed as argument, not assertion, and have counsel review before go-live. */}
<section class="dh-section dh-section--ink" aria-labelledby="dh-now-title">
  <div class="dh-wrap dh-narrow">
    <h2 class="dh-h2" id="dh-now-title">"We have it turned on" is no longer enough.</h2>
    <p class="dh-body dh-body--large">
      Clients, insurers and regulators increasingly expect businesses to show, not just state, that reasonable security steps have been taken. Insurers have disputed claims where a control such as multi-factor authentication was declared on the proposal form but was not actually enforced. The gap between what a firm believes is in place and what it can evidence is where the exposure sits.
    </p>
  </div>
</section>

<!-- 5. The Decoheron difference -->
<section class="dh-section dh-section--paper" aria-labelledby="dh-diff-title">
  <div class="dh-wrap">
    <h2 class="dh-h2" id="dh-diff-title">Evidence, not opinions.</h2>
    <p class="dh-body">Using the Microsoft security you already own, we implement controls that are:</p>
    <ul class="dh-pillars">
      {pillars.map((p) => (
        <li class="dh-pillar">
          <span class="dh-pillar__icon" set:html={icon(p.icon)} />
          <h3 class="dh-pillar__name">{p.name}</h3>
          <p>{p.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<!-- 6. The Security Assurance Program -->
{/* PREPARER NOTE: (1) Card names now match the four service lines and the proposal template. The previous "Deterministic Access Controls" (deny-by-default Conditional Access) has been folded into Session Protection; confirm with Rob. (2) Network segmentation removed from the backups card, as it isn't delivered from the client's existing Microsoft stack; add back only if it's in scope. (3) Confirm Veristate reporting cadence. Do not describe Veristate as "attestation" or "proof of operating effectiveness", as Decoheron implements the controls it reports on. */}
<section class="dh-section" aria-labelledby="dh-program-title">
  <div class="dh-wrap">
    <div class="dh-narrow dh-centre">
      <h2 class="dh-h2" id="dh-program-title">Five controls. One body of evidence.</h2>
      <p class="dh-body">
        Each control closes a specific, common path to a breach. VeriState™ reporting then shows you, and anyone who asks, that each one is working.
      </p>
    </div>

    <figure class="dh-ring">
      <svg viewBox="0 0 240 240" role="img" aria-label="Five numbered control segments forming a ring around VeriState™ reporting, which sits across all five controls">
        {ringSegs.map((s) => (
          <>
            <path d={s.d} class={`dh-ring__seg dh-ring__seg--${s.n % 2}`} />
            <text x={s.tx} y={s.ty} class="dh-ring__num">{s.n}</text>
          </>
        ))}
        <text x="120" y="117" class="dh-ring__name">VeriState™</text>
        <text x="120" y="136" class="dh-ring__sub">reporting</text>
      </svg>
      <figcaption>VeriState™ reporting sits across all five controls. It is not a sixth control.</figcaption>
    </figure>

    <ControlCards />
  </div>
</section>

<!-- 7. What changes with Decoheron -->
<section class="dh-section dh-section--paper" aria-labelledby="dh-compare-title">
  <div class="dh-wrap dh-narrow">
    <h2 class="dh-h2" id="dh-compare-title">What changes with Decoheron</h2>
    <div class="dh-table-wrap">
      <table class="dh-table">
        <thead>
          <tr>
            <th scope="col">Typical security engagement</th>
            <th scope="col">Decoheron</th>
          </tr>
        </thead>
        <tbody>
          {comparison.map(([typical, ours]) => (
            <tr>
              <td>{typical}</td>
              <th scope="row">{ours}</th>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>

<!-- 8. How it works -->
<section class="dh-section" aria-labelledby="dh-how-title">
  <div class="dh-wrap">
    <h2 class="dh-h2" id="dh-how-title">How it works</h2>
<ol class="dh-steps" style={`--dh-step-count: ${steps.length}`}>
      {steps.map((s, i) => (
        <li class="dh-step">
          <span class="dh-step__num" aria-hidden="true">Step {i + 1}</span>
          <h3 class="dh-step__name">{s.name}</h3>
          <p>{s.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>


<!-- 9. Working with your MSP -->
<section class="dh-section dh-section--navy" aria-labelledby="dh-msp-title">
  <div class="dh-wrap dh-split">
    <div>
      <h2 class="dh-h2" id="dh-msp-title">We work with your MSP, not against them.</h2>
      <p class="dh-body">
        Many security providers compete with your managed service provider. We don't. Your MSP keeps running your environment day to day. We design, implement and verify the security controls, and give both of you clear evidence of what's working.
      </p>
    </div>
    <ul class="dh-checks">
      {mspPoints.map((p) => (
        <li>
          <span class="dh-checks__icon" set:html={icon('check')} />
          <span>{p}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<!-- 10. Industries -->
{/* PREPARER NOTE: the wealth management statement refers to ASIC v FIIG Securities Limited [2026] FCA 92. Link to the judgment or ASIC media release, and have counsel review before go-live. */}
<section class="dh-section dh-section--paper" aria-labelledby="dh-ind-title">
  <div class="dh-wrap">
    <h2 class="dh-h2" id="dh-ind-title">Built for professional services</h2>
    <div class="dh-industries">
      {industries.map((ind) => (
        <article class="dh-industry">
          <span class="dh-industry__icon" set:html={icon(ind.icon)} />
          <h3>{ind.name}</h3>
          <p>{ind.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- 11. Final call to action -->
<section class="dh-section dh-section--ink dh-cta" aria-labelledby="dh-cta-title">
  <div class="dh-wrap dh-narrow dh-centre">
    <h2 class="dh-h2" id="dh-cta-title">Know where you stand. Then prove it.</h2>
    <p class="dh-body dh-body--large">
      Start with an assessment of your Microsoft security against the ASD aligned E8 and new ASD Essentials. You'll get a clear picture of where you stand today, and a costed roadmap to an evidenced, audit-ready environment.
    </p>
    <div class="dh-hero__actions dh-hero__actions--centre">
      <a class="dh-btn dh-btn--primary" href="#briefing">Book a Call</a>
    </div>
  </div>
</section>

  
      <BriefingForm hidden={true} />
</BaseLayout>

<style>
  .dh-hero, .dh-section {
    --dh-navy: #0A1B6B;
    --dh-ink: #050D2E;
    --dh-indigo: #0310A4;
    --dh-paper: #F5F6FA;
    --dh-gold: #D8AE4E;
    --dh-text: #2A3358;
    --dh-serif: "Helvetica Neue", Helvetica, Arial, sans-serif;
    --dh-sans: "Helvetica Neue", Helvetica, Arial, sans-serif;
    font-family: var(--dh-sans);
    -webkit-font-smoothing: antialiased;
  }
  .dh-hero *, .dh-section * { box-sizing: border-box; }

  /* Shared */
  :global(.dh-ico) {
    width: 1.5rem;
    height: 1.5rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .dh-eyebrow {
    margin: 0 0 1.25rem;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--dh-gold);
  }
  .dh-section { background: #fff; color: var(--dh-ink); padding: clamp(3rem, 6vw, 5.5rem) 1.5rem; }
  .dh-section--tight { padding-top: 1.75rem; padding-bottom: 1.75rem; }
  .dh-section--paper { background: var(--dh-paper); }
  .dh-section--navy { background: var(--dh-navy); color: #fff; }
  .dh-section--ink { background: var(--dh-ink); color: #fff; }
  .dh-wrap { max-width: 1180px; margin: 0 auto; }
  .dh-narrow { max-width: 50rem; }
  .dh-wrap.dh-narrow { margin-left: auto; margin-right: auto; }
  .dh-centre { text-align: center; }
  .dh-split { display: grid; gap: 2.5rem; align-items: start; }
  @media (min-width: 900px) { .dh-split { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 4rem; } }

  .dh-h2 {
    margin: 0;
    font-family: var(--dh-serif);
    font-weight: 400;
    font-size: clamp(1.875rem, 3.6vw, 2.75rem);
    line-height: 1.1;
    letter-spacing: -0.012em;
    text-wrap: balance;
    color: var(--dh-navy);
  }
  .dh-section--navy .dh-h2, .dh-section--ink .dh-h2 { color: #fff; }
  .dh-body { margin: 1.25rem 0 0; font-size: 1.125rem; line-height: 1.6; color: var(--dh-text); }
  .dh-section--navy .dh-body, .dh-section--ink .dh-body { color: rgba(255, 255, 255, 0.84); }
  .dh-body--large { font-size: 1.1875rem; line-height: 1.65; }
  .dh-body--lead { margin-top: 1.75rem; font-weight: 600; color: var(--dh-navy); }
  .dh-centre .dh-body { margin-left: auto; margin-right: auto; }

  /* Hero */
  .dh-hero {
    background: var(--dh-navy);
    color: #fff;
    padding: clamp(3rem, 7vw, 6.5rem) 1.5rem;
  }
  /* Single column while the matrix panel is off. Use grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr) at 960px+ to bring it back. */
  .dh-hero__inner {
    max-width: 1180px;
    margin: 0 auto;
    display: grid;
    gap: clamp(2.5rem, 5vw, 4.5rem);
    align-items: center;
  }

  .dh-hero__title {
    margin: 0;
    font-family: var(--dh-serif);
    font-weight: 400;
    font-size: clamp(2.25rem, 4.6vw, 3.75rem);
    line-height: 1.05;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }
  .dh-hero__title span { display: block; }
  .dh-hero__title span + span { color: rgba(255, 255, 255, 0.6); margin-top: 0.15em; }
  .dh-hero__title + .dh-hero__lede { margin-top: 1.75rem; }

  .dh-hero__lede {
    margin: 1.25rem 0 0;
    max-width: 40rem;
    font-size: 1.125rem;
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.84);
  }
  .dh-hero__note { margin: 1rem 0 0; font-size: 0.9375rem; color: rgba(255, 255, 255, 0.7); }

  .dh-hero__actions {
    margin-top: 2.25rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.875rem;
  }
  .dh-hero__actions--centre { justify-content: center; }
  .dh-btn {
    display: inline-block;
    padding: 0.9rem 1.5rem;
    border-radius: 4px;
    font: 600 1rem/1.2 var(--dh-sans);
    text-decoration: none;
    border: 1px solid transparent;
    transition: background-color 0.15s ease, border-color 0.15s ease;
  }
  .dh-btn--primary { background: var(--dh-gold); color: var(--dh-ink); }
  .dh-btn--primary:hover { background: #E4BD62; }
  .dh-btn--secondary { color: #fff; border-color: rgba(255, 255, 255, 0.45); }
  .dh-btn--secondary:hover { border-color: #fff; background: rgba(255, 255, 255, 0.06); }
  @media (max-width: 520px) { .dh-btn { width: 100%; text-align: center; } }
  .dh-btn:focus-visible { outline: 3px solid var(--dh-gold); outline-offset: 3px; }

  /* VeriState panel (static, currently switched off in the markup) */
  .dh-panel {
    margin: 0;
    background: #F6F7F9;
    color: var(--dh-ink);
    border-radius: 10px;
    padding: 1rem clamp(0.6rem, 2vw, 1rem) 1rem;
    box-shadow: 0 24px 48px -24px rgba(0, 0, 0, 0.55);
  }
  .dh-panel__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.25rem 1rem;
    padding: 0 0.35rem 0.75rem;
  }
  .dh-panel__title { margin: 0; font-size: 1rem; font-weight: 700; color: var(--dh-ink); }
  .dh-panel__sample { font-size: 0.8125rem; color: #4B5563; }

  .dh-tiles { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.65rem; }
  .dh-tile { background: #fff; border-radius: 8px; padding: 0.55rem; box-shadow: 0 1px 2px rgba(15, 23, 42, 0.08); }

  .dh-tile__banner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    padding: 1.6rem 0.75rem 1.4rem;
    border: 1px solid #A9C0E6;
    border-radius: 7px;
    background: linear-gradient(90deg, #86A5D6, #C5D9F8);
  }
  .dh-tile__badge {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 50%;
    background: #fff;
    color: #1E8449;
  }
  .dh-tile__title { margin: 0; font-size: 0.9375rem; font-weight: 600; line-height: 1.25; text-align: center; color: var(--dh-ink); }

  .dh-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* Trust bar */
  .dh-trust {
    list-style: none;
    margin-top: 0;
    margin-bottom: 0;
    padding: 0;
    display: grid;
    gap: 1.25rem 2rem;
  }
  @media (min-width: 640px) { .dh-trust { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1000px) { .dh-trust { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .dh-trust__item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.35;
    color: var(--dh-navy);
  }
  .dh-trust__icon { flex: none; color: var(--dh-indigo); display: grid; }

  /* Problem */
  .dh-questions { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.875rem; }
  .dh-questions li {
    display: flex;
    gap: 0.875rem;
    align-items: flex-start;
    padding: 1rem 1.125rem;
    background: var(--dh-paper);
    border-left: 3px solid var(--dh-navy);
