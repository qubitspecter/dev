---
import BaseLayout from '../layouts/BaseLayout.astro';
import BriefingForm from '../components/BriefingForm.astro';
import ControlCards from '../components/ControlCards.astro';
import { icon, controls } from '../data/controls';


const pillars = [
    { icon: 'checkCircle', lead: 'ASD Essentials & SMB1001 aligned security controls', },
    { icon: 'cloud', lead: 'Optimise and enhance your existing Microsoft environment', text: 'We don\'t sell new tools. We make the Microsoft security you\'ve paid for do its job.' },
    { icon: 'clipboard', lead: 'Designed for Regulated Professional Services', text: 'You know what you\'re getting, and what it costs, before we start.' },
    { icon: 'users', lead: 'Works with your existing MSP', text: 'We strengthen the environment your MSP runs, rather than competing for it.' },
];

const comparison = [
    ['Security reviews', 'Continuous verification'],
    ['Best-effort controls', 'Deterministic controls'],
    ['Security opinions', 'Standards alignment'],
    ['Added tool complexity', 'Microsoft optimisation'],
    ['Open-ended consulting hours', 'Fixed-scope, fixed-price phases'],
    ['"Trust us."', '"Here\'s the evidence."'],
];
---

<BaseLayout title="Decoheron - Outcome Focused Cyber Security">

<!-- 1. Hero -->
<section class="dh-hero dh-hero--compact dh-hero--home" aria-labelledby="dh-hero-title">
  <div class="dh-wrap dh-split dh-split--hero">
    <div>
      <p class="dh-eyebrow">Cybersecurity for regulated SMB and Mid-Market business</p>
      
        <!-- Specialising in legal, accounting, and wealth management firms.-->
      <h1 class="ph-hero__title">
        <span>Security as a finished product,</span><br>
        <span>not a treadmill.</span>
      </h1>
      <p class="dh-hero__lede">
         Decoheron implements complete, enforced security in the Microsoft environment you already own. We assess for alignment with ASD Essentials and SMB1001. We then verify and attest to it daily, so you can show your board, your clients, your insurer or an auditor exactly where you stand, on demand. Built for regulated ogranisations such as legal, accounting and wealth management. We work alongside your existing IT provider to empower them.
      </p>
      <div class="dh-actions">
        <a class="dh-btn dh-btn--primary" href="#briefing">Book a Call</a>
        <a class="dh-btn dh-btn--secondary" href="/solution">See How It Works</a>
      </div>
    </div>
  </div>
</section>

<section class="dh-section dh-section--paper" aria-labelledby="dh-diff-title">
  <div class="dh-wrap">
    <ul class="dh-grid dh-grid--4 dh-grid--spaced">
      {pillars.map((p) => (
        <li class="dh-point">
          <span class="dh-point__icon" set:html={icon(p.icon)} />
          <h3 class="dh-h3">{p.lead}</h3>
        </li>
      ))}
    </ul>
  </div>
</section>


<!-- 7. What changes with Decoheron -->
<section class="dh-section dh-section--white" aria-labelledby="dh-compare-title">
  <div class="dh-wrap dh-narrow">
    <h2 class="dh-h2" id="dh-compare-title">The Decoheron Difference</h2>
    <div class="dh-table-wrap">
      <table class="dh-table">
        <thead>
          <tr>
            <th scope="col">Typical security engagement</th>
            <th scope="col">Decoheron</th>
          </tr>
        </thead>
        <tbody>
          {comparison.map(([typical, ours]) => (
            <tr>
              <td>{typical}</td>
              <th scope="row">{ours}</th>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>

  
      <BriefingForm hidden={true} />
</BaseLayout>

